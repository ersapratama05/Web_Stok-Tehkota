# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Supabase / Neon / Vercel Postgres)
# Wajib diisi di Vercel Environment Variables agar data tersimpan permanen lintas perangkat!
# Contoh Neon: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Contoh Supabase Pooler: postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# AUTH_SECRET: Kunci penandatanganan sesi token server (disarankan string acak minimal 32 karakter)
AUTH_SECRET=""

# Kredensial Owner (opsional override dari default seed; disarankan segera diganti di Vercel Env Vars)
OWNER_USERNAME=""
OWNER_PASSWORD=""
KASIR_SOMPOK_PASSWORD=""
KASIR_SUYUDONO_PASSWORD=""
